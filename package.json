{
  "name": "gamegrid",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop": "electron electron/main.cjs",
    "build:desktop": "npm run build && node electron/prepare-standalone.cjs && electron-builder --win portable",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "mcp:playwright": "node -e \"require('@playwright/mcp'); console.log('Playwright MCP loaded')\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.477.0",
    "next": "14.2.16",
    "react": "^18",
    "react-dom": "^18",
    "react-easy-crop": "^5.5.6",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "build": {
    "appId": "space.shatranj.gamegrid",
    "productName": "GameGrid",
    "artifactName": "GameGrid-${version}-portable.${ext}",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.41",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.16",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
